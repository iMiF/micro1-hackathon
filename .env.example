# Copy this file to `.env` and fill in the values below.
# `.env` is gitignored — it is never committed, and it is the only file that
# should hold real secrets in this repo.

# Required to run either agent (baseline or AAE) against the live model.
# Not required for `npm run baseline:selftest` or `npm run harness:selftest`
# (no LLM call, no target).
OPENROUTER_API_KEY=

# Everything below is optional. The seeded MiniCRM demo credentials and the
# default target URL are already committed in config/run.default.json,
# because MiniCRM is a synthetic sandbox judges are expected to run locally
# (see that file's $comment). Set these only if you are pointing the harness
# at a target that isn't the local sandbox on its default port.
# MINICRM_URL=
# AAE_EMAIL=
# AAE_PASSWORD=

# Set to 1 to run the browser headed instead of headless (debugging only).
# HEADED=
